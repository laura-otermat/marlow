# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=

# Supabase project URL and anon (public) key
SUPABASE_URL=
SUPABASE_KEY=

# Server-only: used to create households and send invitations
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Auth UUID of the user allowed to create households
PLATFORM_ADMIN_USER_ID=
